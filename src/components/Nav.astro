---
const base = import.meta.env.BASE_URL;
const path = Astro.url.pathname;

function isActive(href: string) {
    if (href === base) return path === base;
    return path.startsWith(href);
}
---
<nav>
    <a href={base} class="logo">
        TODOS<br>ESOS<br>HOMBRES
    </a>
    <ul>
        <li><a href={base} class:list={{ active: isActive(base) }} data-i18n="nav.inicio">INICIO</a></li>
        <li><a href={`${base}estadisticas/`} class:list={{ active: isActive(`${base}estadisticas/`) }} data-i18n="nav.estadisticas">ESTADÍSTICAS</a></li>
        <li><a href={`${base}asimetrias/`} class:list={{ active: isActive(`${base}asimetrias/`) }} data-i18n="nav.asimetrias">ASIMETRÍAS</a></li>
        <li><a href={`${base}blog/`} class:list={{ active: isActive(`${base}blog/`) }} data-i18n="nav.blog">BLOG</a></li>
        <li><a href={`${base}proposito/`} class:list={{ active: isActive(`${base}proposito/`) }} data-i18n="nav.proposito">PROPÓSITO</a></li>
    </ul>
</nav>

<style>
    nav {
        position: fixed;
        top: 0;
        width: 100%;
        background: #fff;
        border-bottom: 3px solid #000;
        z-index: 1000;
        padding: 1.5rem 2rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .logo {
        font-family: 'Bebas Neue', sans-serif;
        font-size: 1.5rem;
        line-height: 0.85;
        color: #000;
        text-decoration: none;
        text-transform: uppercase;
        letter-spacing: -1px;
    }

    nav ul {
        list-style: none;
        display: flex;
        gap: 2.5rem;
    }
    nav a {
        color: #000;
        text-decoration: none;
        font-weight: 700;
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        transition: opacity 0.3s;
        padding: 0.5rem 1rem;
    }
    nav a:hover {
        opacity: 0.6;
    }

    nav a.active {
        background: #000;
        color: #fff;
        padding: 0.5rem 1rem;
    }

    @media (max-width: 968px) {
        nav {
            flex-direction: column;
            gap: 0.75rem;
            padding: 1rem;
        }

        nav ul {
            gap: 0.5rem;
            flex-wrap: wrap;
            justify-content: center;
        }

        nav a {
            font-size: 0.75rem;
            padding: 0.4rem 0.7rem;
        }
    }

    @media (max-width: 480px) {
        nav a {
            font-size: 0.7rem;
            padding: 0.35rem 0.6rem;
        }
    }
</style>
