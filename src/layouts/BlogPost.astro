---
import Nav from '../components/Nav.astro';

interface Source {
    name: string;
    url: string;
}

interface Props {
    title: string;
    subtitle?: string;
    category: string;
    date: string;
    footerCopy?: string;
    sources?: Source[];
}

const {
    title,
    subtitle,
    category,
    date,
    footerCopy = 'TODOS ESOS HOMBRES © 2026 — FUENTES: INE, SEPE, MINISTERIO DE TRABAJO',
    sources = [],
} = Astro.props;
---
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title} — Blog</title>
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
</head>
<body>

<Nav />

<header class="article-header">
    <h1 class="article-title">{title}</h1>
    {subtitle && <p class="article-subtitle">{subtitle}</p>}
    <div class="article-meta">{date} — {category}</div>
</header>

<article class="container">
    <slot />

    {sources.length > 0 && (
        <div class="sources">
            <h3 data-i18n="blog.fuentes">🔎 Fuentes</h3>
            <ul>
                {sources.map((source) => (
                    <li>
                        <strong>{source.name}</strong><br />
                        <a href={source.url} target="_blank" rel="noopener">{source.url}</a>
                    </li>
                ))}
            </ul>
        </div>
    )}
</article>

<footer>
    <p data-i18n="blog.footer.precio">{footerCopy}</p>
</footer>

<script src="/teh_i18n.js" is:inline></script>

<style is:global>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { background: #fff; color: #000; font-family: 'Space Mono', monospace; line-height: 1.6; }

    .article-header {
        background: #000;
        color: #fff;
        padding: 8rem 2rem 4rem;
        text-align: center;
    }

    .article-title {
        font-family: 'Bebas Neue', sans-serif;
        font-size: clamp(3rem, 8vw, 6rem);
        line-height: 1;
        margin-bottom: 2rem;
        text-transform: uppercase;
    }

    .article-subtitle {
        font-size: 1.2rem;
        opacity: 0.8;
        max-width: 700px;
        margin: 0 auto;
    }

    .article-meta {
        margin-top: 2rem;
        font-size: 0.85rem;
        opacity: 0.6;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .container {
        max-width: 900px;
        margin: 0 auto;
        padding: 4rem 2rem;
    }

    .lead-text {
        font-size: 1.3rem;
        line-height: 1.8;
        margin-bottom: 3rem;
        padding: 2rem;
        background: #f5f5f5;
        border-left: 10px solid #000;
    }

    .stat-comparison {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 2rem;
        margin: 4rem 0;
    }

    .stat-box {
        border: 3px solid #000;
        padding: 2.5rem;
        margin: 3rem 0;
        text-align: center;
        transition: all 0.3s ease;
    }

    .stat-comparison .stat-box {
        margin: 0;
    }

    .stat-box:hover {
        transform: translate(-6px, -6px);
        box-shadow: 6px 6px 0 #000;
    }

    .stat-box.highlight {
        background: #000;
        color: #fff;
    }

    .stat-number {
        font-family: 'Bebas Neue', sans-serif;
        font-size: 4rem;
        line-height: 1;
        margin-bottom: 1rem;
    }

    .stat-label {
        font-size: 0.9rem;
        text-transform: uppercase;
        font-weight: 700;
        letter-spacing: 0.5px;
    }

    .stat-sublabel {
        font-size: 0.8rem;
        opacity: 0.7;
        margin-top: 0.5rem;
    }

    .comparison-giant {
        background: #f5f5f5;
        padding: 4rem 2rem;
        margin: 5rem -2rem;
        text-align: center;
        border-top: 3px solid #000;
        border-bottom: 3px solid #000;
    }

    .comparison-giant h3 {
        font-family: 'Bebas Neue', sans-serif;
        font-size: 2rem;
        margin-bottom: 2rem;
        text-transform: uppercase;
    }

    .comparison-numbers {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 2rem;
        flex-wrap: wrap;
        margin-top: 2rem;
    }

    .vs-number {
        font-family: 'Bebas Neue', sans-serif;
        font-size: clamp(3rem, 8vw, 6rem);
        line-height: 1;
    }

    .vs-number span {
        display: block;
        font-size: 1rem;
        font-family: 'Space Mono', monospace;
        text-transform: uppercase;
        margin-top: 1rem;
    }

    .vs-separator {
        font-family: 'Bebas Neue', sans-serif;
        font-size: 3rem;
        opacity: 0.3;
    }

    .multiplier {
        background: #000;
        color: #fff;
        padding: 2rem;
        margin-top: 2rem;
        display: inline-block;
    }

    .multiplier-text {
        font-family: 'Bebas Neue', sans-serif;
        font-size: 3rem;
    }

    h2 {
        font-family: 'Bebas Neue', sans-serif;
        font-size: 2.5rem;
        margin: 3rem 0 1.5rem;
        text-transform: uppercase;
    }

    p {
        margin-bottom: 1.5rem;
        font-size: 1.05rem;
        line-height: 1.8;
    }

    .highlight-text {
        background: #000;
        color: #fff;
        padding: 0.3rem 0.6rem;
        font-weight: 700;
    }

    .data-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 2rem;
        margin: 3rem 0;
    }

    .data-card {
        border: 3px solid #000;
        padding: 2rem;
        background: #f9f9f9;
    }

    .data-card h4 {
        font-family: 'Bebas Neue', sans-serif;
        font-size: 1.5rem;
        margin-bottom: 1rem;
        text-transform: uppercase;
    }

    .data-card ul {
        list-style: none;
        padding-left: 0;
    }

    .data-card li {
        padding: 0.5rem 0;
        border-bottom: 1px solid #ddd;
    }

    .data-card li:last-child {
        border-bottom: none;
    }

    .data-card li::before {
        content: "→ ";
        font-weight: 700;
    }

    .callout-box {
        background: #000;
        color: #fff;
        padding: 3rem;
        margin: 4rem 0;
        border: 3px solid #000;
    }

    .callout-box h3 {
        font-family: 'Bebas Neue', sans-serif;
        font-size: 2rem;
        margin-bottom: 1.5rem;
    }

    .callout-box p {
        font-size: 1.1rem;
        line-height: 1.8;
    }

    .sources {
        background: #f5f5f5;
        padding: 3rem;
        margin: 4rem 0;
        border: 3px solid #000;
    }

    .sources h3 {
        font-family: 'Bebas Neue', sans-serif;
        font-size: 2rem;
        margin-bottom: 1.5rem;
        text-transform: uppercase;
    }

    .sources ul {
        list-style: none;
        padding: 0;
    }

    .sources li {
        margin-bottom: 1rem;
        padding-bottom: 1rem;
        border-bottom: 1px solid #ddd;
    }

    .sources li:last-child {
        border-bottom: none;
    }

    .sources a {
        color: #000;
        text-decoration: underline;
        word-break: break-all;
        font-size: 0.9rem;
    }

    .quote-box {
        border-left: 10px solid #000;
        padding-left: 2rem;
        margin: 3rem 0;
        font-size: 1.2rem;
        font-style: italic;
    }

    .case-box {
        background: #f5f5f5;
        border: 3px solid #000;
        padding: 2rem;
        margin: 2rem 0;
    }

    .case-box h4 {
        font-family: 'Bebas Neue', sans-serif;
        font-size: 1.3rem;
        margin-bottom: 1rem;
    }

    .profile-box {
        background: #f5f5f5;
        border: 3px solid #000;
        padding: 2.5rem;
        margin: 2rem 0;
    }

    .profile-box h4 {
        font-family: 'Bebas Neue', sans-serif;
        font-size: 1.5rem;
        margin-bottom: 1rem;
    }

    .sector-card {
        border: 3px solid #000;
        padding: 2rem;
        transition: all 0.3s ease;
    }

    .sector-card:hover {
        transform: translate(-4px, -4px);
        box-shadow: 4px 4px 0 #000;
    }

    .sector-card h4 {
        font-family: 'Bebas Neue', sans-serif;
        font-size: 1.5rem;
        margin-bottom: 1rem;
        text-transform: uppercase;
    }

    .sector-stat {
        display: flex;
        justify-content: space-between;
        padding: 0.5rem 0;
        border-bottom: 1px solid #ddd;
        font-size: 0.95rem;
    }

    .sector-stat:last-child {
        border-bottom: none;
    }

    .comparison-table {
        margin: 3rem 0;
        border: 3px solid #000;
        overflow: hidden;
    }

    .comparison-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        border-bottom: 2px solid #000;
    }

    .comparison-row:last-child {
        border-bottom: none;
    }

    .comparison-cell {
        padding: 1.5rem;
        border-right: 2px solid #000;
    }

    .comparison-cell:last-child {
        border-right: none;
    }

    .comparison-cell.header {
        background: #000;
        color: #fff;
        font-family: 'Bebas Neue', sans-serif;
        font-size: 1.3rem;
        text-align: center;
    }

    .comparison-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 2rem;
        margin: 3rem 0;
    }

    .comparison-item {
        border: 3px solid #000;
        padding: 2rem;
    }

    .comparison-item.left {
        background: #000;
        color: #fff;
    }

    .comparison-item h4 {
        font-family: 'Bebas Neue', sans-serif;
        font-size: 1.8rem;
        margin-bottom: 1rem;
    }

    footer {
        padding: 4rem;
        text-align: center;
        border-top: 3px solid #000;
        opacity: 0.6;
        font-size: 0.8rem;
    }

    @media (max-width: 768px) {
        .comparison-row {
            grid-template-columns: 1fr;
        }

        .comparison-cell {
            border-right: none;
            border-bottom: 2px solid #000;
        }

        .comparison-cell:last-child {
            border-bottom: none;
        }

        .comparison-grid {
            grid-template-columns: 1fr;
        }

        .article-header {
            padding: 17rem 1.5rem 3rem;
        }

        .container {
            padding: 3rem 1.5rem;
        }

        .stat-comparison {
            grid-template-columns: 1fr;
            gap: 1rem;
        }

        .stat-number {
            font-size: 3rem;
        }

        .comparison-giant {
            margin-left: 0;
            margin-right: 0;
            padding: 3rem 1.5rem;
        }

        .comparison-numbers {
            flex-direction: column;
            gap: 1rem;
        }

        .vs-separator {
            font-size: 2rem;
        }

        .data-grid {
            gap: 1rem;
        }

        .callout-box {
            padding: 2rem 1.5rem;
        }

        .sources {
            padding: 2rem 1.5rem;
        }

        .lead-text {
            padding: 1.5rem;
            font-size: 1.1rem;
        }
    }
</style>
</body>
</html>
