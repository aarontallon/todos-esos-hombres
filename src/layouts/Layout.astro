---
import Head from '../components/Head.astro';
import Nav from '../components/Nav.astro';

interface Props {
    title: string;
    description?: string;
    footerCopy?: string;
}

const {
    title,
    description,
    footerCopy = 'TODOS ESOS HOMBRES © 2026 — FUENTES: INE, SEPE, MINISTERIO DE TRABAJO',
} = Astro.props;
const base = import.meta.env.BASE_URL;
---
<!DOCTYPE html>
<html lang="es">
<head>
    <Head title={title} description={description} />
</head>
<body>

<a href="#contenido" class="skip-link">Saltar al contenido</a>

<Nav />

<main id="contenido">
    <slot />
</main>

<footer>
    <p data-i18n="footer.copy">{footerCopy}</p>
</footer>

<script src={`${base}teh_i18n.js`} is:inline></script>

<style is:global>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { background: #fff; color: #000; font-family: 'Space Mono', monospace; line-height: 1.6; overflow-x: hidden; }

    /* Evita el parpadeo de todos los idiomas apilados antes de que cargue teh_i18n.js */
    [data-lang-block]:not([data-lang-block="es"]) { display: none; }

    footer {
        padding: 4rem 2rem;
        border-top: 3px solid #000;
        text-align: center;
        font-size: 0.75rem;
        opacity: 0.5;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    /* Accesibilidad: salto al contenido, foco visible y menos movimiento */
    .skip-link {
        position: absolute;
        left: 1rem;
        top: -4rem;
        z-index: 2000;
        background: #000;
        color: #fff;
        padding: 0.75rem 1.25rem;
        font-weight: 700;
        text-decoration: none;
    }
    .skip-link:focus { top: 1rem; }

    :focus-visible { outline: 3px solid #000; outline-offset: 3px; }
    .skip-link:focus-visible,
    .article-header :focus-visible { outline-color: #fff; }

    @media (prefers-reduced-motion: reduce) {
        *, *::before, *::after {
            animation-duration: 0.01ms !important;
            animation-iteration-count: 1 !important;
            transition-duration: 0.01ms !important;
            scroll-behavior: auto !important;
        }
    }
</style>
</body>
</html>
