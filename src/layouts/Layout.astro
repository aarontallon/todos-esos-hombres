---
import Nav from '../components/Nav.astro';

interface Props {
    title: string;
    footerCopy?: string;
}

const { title, footerCopy = 'TODOS ESOS HOMBRES © 2026 — FUENTES: INE, SEPE, MINISTERIO DE TRABAJO' } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title}</title>
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
</head>
<body>

<Nav />

<slot />

<footer>
    <p data-i18n="footer.copy">{footerCopy}</p>
</footer>

<script src={`${base}teh_i18n.js`} is:inline></script>

<style is:global>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { background: #fff; color: #000; font-family: 'Space Mono', monospace; line-height: 1.6; overflow-x: hidden; }

    /* Evita el parpadeo de todos los idiomas apilados antes de que cargue teh_i18n.js */
    [data-lang-block]:not([data-lang-block="es"]) { display: none; }

    footer {
        padding: 4rem 2rem;
        border-top: 3px solid #000;
        text-align: center;
        font-size: 0.75rem;
        opacity: 0.5;
        text-transform: uppercase;
        letter-spacing: 1px;
    }
</style>
</body>
</html>
