---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Asimetrías Legales — Todos esos hombres" footerCopy="TODOS ESOS HOMBRES © 2026">
    <div class="container">
        <div class="header-section">
            <div class="header-text">
                <h1 data-i18n="asym.title">ASIMETRÍAS LEGALES</h1>
                <p data-i18n="asym.subtitle">Recopilación detallada de discriminaciones legales por sexo extraídas del BOE y fuentes oficiales del Gobierno.</p>
            </div>
            <a href="#formulario-envio" class="btn-submit-top" id="btnSubmitTop" data-i18n="asym.btn.enviar">+ Enviar Asimetría</a>
        </div>

        <div class="search-panel">
            <div class="search-row">
                <input type="text" id="lawSearch" data-i18n-placeholder="asym.search.ph" placeholder="BUSCAR POR LEY, PALABRA CLAVE O REFERENCIA BOE...">
            </div>
            <div class="filter-group">
                <button class="filter-btn active" data-filter="all" data-i18n="asym.filter.todas">Todas</button>
                <button class="filter-btn" data-filter="PENAL" data-i18n="asym.filter.penal">Penal</button>
                <button class="filter-btn" data-filter="SOCIAL" data-i18n="asym.filter.social">Seguridad Social</button>
                <button class="filter-btn" data-filter="EMPLEO" data-i18n="asym.filter.empleo">Empleo/Empresa</button>
                <button class="filter-btn" data-filter="ADMIN" data-i18n="asym.filter.admin">Admin/Varios</button>
                <button class="filter-btn" data-filter="EDUCACIÓN" data-i18n="asym.filter.edu">Educación</button>
                <button class="filter-btn" data-filter="VIVIENDA" data-i18n="asym.filter.viv">Vivienda</button>
            </div>
            <div class="search-options">
                <div class="search-option">
                    <input type="checkbox" id="searchTitle" checked>
                    <label for="searchTitle" data-i18n="asym.search.titulo">Buscar en título</label>
                </div>
                <div class="search-option">
                    <input type="checkbox" id="searchDesc" checked>
                    <label for="searchDesc" data-i18n="asym.search.desc">Buscar en descripción</label>
                </div>
                <div class="search-option">
                    <input type="checkbox" id="searchAsym" checked>
                    <label for="searchAsym" data-i18n="asym.search.asym">Buscar en asimetría</label>
                </div>
                <div class="search-option">
                    <input type="checkbox" id="searchRef">
                    <label for="searchRef" data-i18n="asym.search.ref">Buscar en referencia</label>
                </div>
            </div>
        </div>

        <div class="results-info" id="resultsInfo"></div>

        <div id="lawsContainer"></div>
        <div id="noResults" class="no-results" style="display: none;" data-i18n="asym.noresults">
            No se encontraron resultados para tu búsqueda.
        </div>

        <div class="form-section" id="formulario-envio">
            <h3 data-i18n="asym.form.title">ENVIAR NUEVA ASIMETRÍA</h3>
            <p style="margin-bottom: 2rem;" data-i18n="asym.form.intro">Si conoces una ley oficial que falte, envíala indicando la referencia del BOE.</p>
            <form id="asymmetryForm">
                <div class="form-group"><label data-i18n="asym.form.ley">Título de la Ley *</label><input type="text" required></div>
                <div class="form-group"><label data-i18n="asym.form.desc">Descripción Detallada *</label><textarea rows="4" required></textarea></div>
                <div class="form-group"><label data-i18n="asym.form.enlace">Enlace BOE / Oficial *</label><input type="url" required></div>
                <button type="submit" class="submit-btn" data-i18n="asym.form.submit">ENVIAR PARA REVISIÓN</button>
            </form>
        </div>
    </div>
</Layout>

