const container = document.getElementById('lawsContainer')!;
const searchInput = document.getElementById('lawSearch') as HTMLInputElement;
const resultsInfo = document.getElementById('resultsInfo')!;
const noResults = document.getElementById('noResults')!;

const searchTitle = document.getElementById('searchTitle') as HTMLInputElement;
const searchDesc = document.getElementById('searchDesc') as HTMLInputElement;
const searchAsym = document.getElementById('searchAsym') as HTMLInputElement;
const searchRef = document.getElementById('searchRef') as HTMLInputElement;

function highlightText(text: string, query: string) {
    if (!query) return text;
    const escapedQuery = query.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
    const regex = new RegExp(`(${escapedQuery})`, 'gi');
    return text.replace(regex, '<mark>$1</mark>');
}

function currentLang(): keyof LangText {
    const lang = (window as any).TEH_i18n ? (window as any).TEH_i18n.currentLang() : 'es';
    return (['es', 'ca', 'gl', 'eu', 'oc'].includes(lang) ? lang : 'es') as keyof LangText;
}

function render(filter = 'all', query = '') {
    container.innerHTML = '';
    noResults.style.display = 'none';

    const lang = currentLang();
    const queryLower = query.toLowerCase();

    const filtered = laws.filter((l) => {
        const matchesFilter = filter === 'all' || l.cat === filter;

        if (!matchesFilter) return false;
        if (!query) return true;

        let matchesQuery = false;

        if (searchTitle.checked && l.title[lang].toLowerCase().includes(queryLower)) matchesQuery = true;
        if (searchDesc.checked && l.desc[lang].toLowerCase().includes(queryLower)) matchesQuery = true;
        if (searchAsym.checked && l.asym[lang].toLowerCase().includes(queryLower)) matchesQuery = true;
        if (searchRef.checked && l.ref.toLowerCase().includes(queryLower)) matchesQuery = true;

        return matchesQuery;
    });

    if (filtered.length === 0) {
        noResults.style.display = 'block';
        resultsInfo.classList.remove('show');
        return;
    }

    if (query) {
        const tpl = (window as any).TEH_i18n ? (window as any).TEH_i18n.t('asym.results') : 'Se encontraron {n} resultado{s} para "{q}"';
        resultsInfo.textContent = tpl
            .replace('{n}', String(filtered.length))
            .replace('{s}', filtered.length !== 1 ? 's' : '')
            .replace('{s2}', filtered.length !== 1 ? 'it' : 'a')
            .replace('{q}', query);
        resultsInfo.classList.add('show');
    } else {
        resultsInfo.classList.remove('show');
    }

    filtered.forEach((l) => {
        const div = document.createElement('div');
        div.className = 'law-card';
        if (query) div.classList.add('highlighted');

        const ctxLabel = (window as any).TEH_i18n ? (window as any).TEH_i18n.t('asym.card.contexto') : 'Contexto Oficial:';
        const asymLabel = (window as any).TEH_i18n ? (window as any).TEH_i18n.t('asym.card.asimetria') : 'La Asimetría Legal:';
        const srcLabel = (window as any).TEH_i18n ? (window as any).TEH_i18n.t('asym.card.fuente') : 'FUENTE:';

        div.innerHTML = `
            <span class="tag">${l.cat}</span>
            <h2>${highlightText(l.title[lang], query)}</h2>
            <p><strong>${ctxLabel}</strong> ${highlightText(l.desc[lang], query)}</p>
            <div class="asymmetry-box">
                <strong>${asymLabel}</strong>
                ${highlightText(l.asym[lang], query)}
            </div>
            <a href="https://www.boe.es/buscar/doc.php?id=${l.ref}" class="source-link" target="_blank" rel="noopener">${srcLabel} ${highlightText(l.ref, query)} →</a>
        `;
        container.appendChild(div);
    });
}

let searchTimeout: ReturnType<typeof setTimeout>;
searchInput.addEventListener('input', (e) => {
    clearTimeout(searchTimeout);
    searchTimeout = setTimeout(() => {
        const activeFilter = document.querySelector('.filter-btn.active') as HTMLElement;
        render(activeFilter.dataset.filter, (e.target as HTMLInputElement).value);
    }, 300);
});

[searchTitle, searchDesc, searchAsym, searchRef].forEach((checkbox) => {
    checkbox.addEventListener('change', () => {
        const activeFilter = document.querySelector('.filter-btn.active') as HTMLElement;
        render(activeFilter.dataset.filter, searchInput.value);
    });
});

document.querySelectorAll('.filter-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
        document.querySelectorAll('.filter-btn').forEach((f) => f.classList.remove('active'));
        btn.classList.add('active');
        render((btn as HTMLElement).dataset.filter, searchInput.value);
    });
});

render();

document.getElementById('btnSubmitTop')?.addEventListener('click', function (e) {
    e.preventDefault();
    document.querySelector('#formulario-envio')?.scrollIntoView({
        behavior: 'smooth',
        block: 'start',
    });
});

window.addEventListener('langchange', function () {
    const activeFilter = document.querySelector('.filter-btn.active') as HTMLElement;
    render(activeFilter.dataset.filter, searchInput.value);
});

document.getElementById('asymmetryForm')?.addEventListener('submit', function (e) {
    e.preventDefault();
    const msg = (window as any).TEH_i18n ? (window as any).TEH_i18n.t('asym.form.alert') : 'Función de envío en desarrollo.';
    alert(msg);
});
</script>

