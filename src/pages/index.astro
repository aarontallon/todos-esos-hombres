---
import Layout from '../layouts/Layout.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';

const LANGS = ['es', 'ca', 'gl', 'eu', 'oc'];
const base = import.meta.env.BASE_URL;

const allPosts = await getCollection('posts');
const grouped: Record<string, Record<string, CollectionEntry<'posts'>>> = {};
for (const post of allPosts) {
    const [locale, slug] = post.id.split('/');
    grouped[slug] ??= {};
    grouped[slug][locale] = post;
}
const featuredSlug = Object.keys(grouped).find((slug) => grouped[slug].es?.data.featured);
const featuredLangs = featuredSlug ? grouped[featuredSlug] : null;

function localeOf(langs: Record<string, CollectionEntry<'posts'>>, locale: string) {
    return langs[locale] ?? langs.es;
}
---
<Layout title="TODOS ESOS HOMBRES — Inicio">
    <header class="hero">
        <div class="hero-content">
            <p class="hero-eyebrow" data-i18n="index.hero.eyebrow">DATOS OFICIALES · INE, SEPE, MINISTERIO DE TRABAJO</p>
            <h1 class="hero-title" data-i18n="index.hero.title">
                LA REALIDAD<br>QUE NADIE CUENTA
            </h1>
            <p class="hero-subtitle" data-i18n="index.hero.subtitle">
                Datos oficiales sobre las áreas donde los hombres sufren más, mueren más y reciben menos atención
            </p>

            <div class="stats-grid">
                <div class="stat-card">
                    <div class="stat-card-number" data-i18n="index.stat1.number">75%</div>
                    <div class="stat-card-label" data-i18n="index.stat1.label">De los suicidios<br>son masculinos</div>
                </div>
                <div class="stat-card">
                    <div class="stat-card-number" data-i18n="index.stat2.number">91%</div>
                    <div class="stat-card-label" data-i18n="index.stat2.label">De muertes laborales<br>son hombres</div>
                </div>
                <div class="stat-card">
                    <div class="stat-card-number" data-i18n="index.stat3.number">80%</div>
                    <div class="stat-card-label" data-i18n="index.stat3.label">De personas sin hogar<br>son hombres</div>
                </div>
            </div>
        </div>
    </header>

    <section class="data-section">
        <div class="container">
            <div class="data-grid">
                <div class="data-box">
                    <h3 data-i18n="index.data1.number">93%</h3>
                    <p data-i18n="index.data1.text">De las personas presas en España son hombres. El sistema penitenciario es masculino en su inmensa mayoría.</p>
                </div>
                <div class="data-box">
                    <h3 data-i18n="index.data2.number">526</h3>
                    <p data-i18n="index.data2.text">Asimetrías legales documentadas del BOE que discriminan explícitamente por sexo en contra de los hombres.</p>
                </div>
                <div class="data-box">
                    <h3 data-i18n="index.data3.number">-6</h3>
                    <p data-i18n="index.data3.text">Años de esperanza de vida menos que las mujeres. Los hombres mueren antes de forma sistemática.</p>
                </div>
            </div>
        </div>
    </section>

    <section class="mission">
        <div class="mission-content">
            <h2 data-i18n="index.mission.title">UNA REALIDAD QUE EXISTE</h2>
            <p data-i18n="index.mission.p1">En España, <span class="highlight">cada día se suicidan 8 hombres</span>. Cada día mueren 2 hombres en accidentes laborales. Cada noche, 3 de cada 4 personas durmiendo en la calle son hombres.</p>
            <p data-i18n="index.mission.p2">Estos datos no son opiniones. Son estadísticas oficiales del Instituto Nacional de Estadística, del Ministerio de Trabajo, del Instituto Nacional de Seguridad y Salud en el Trabajo.</p>
            <p data-i18n="index.mission.p3">Esta web existe para <span class="highlight">visibilizar lo invisible</span>. Para documentar, con fuentes oficiales y datos verificables, las áreas donde los hombres enfrentan desventajas sistemáticas, sufren más, mueren más, y reciben menos atención.</p>
            <p data-i18n="index.mission.p4">No es un concurso de víctimas. Es un ejercicio de honestidad. Porque la igualdad real requiere mirar toda la realidad, no solo la mitad que nos resulta cómoda.</p>
        </div>
    </section>

    {featuredLangs && (
        <section class="featured">
            <div class="container">
                <p class="featured-kicker" data-i18n="index.featured.kicker">ÚLTIMO ANÁLISIS</p>
                <a href={`${base}blog/${featuredSlug}/`} class="featured-card">
                    <h2 class="featured-title">
                        {LANGS.map((locale) => <span data-lang-block={locale}>{localeOf(featuredLangs, locale).data.title}</span>)}
                    </h2>
                    <p class="featured-excerpt">
                        {LANGS.map((locale) => <span data-lang-block={locale}>{localeOf(featuredLangs, locale).data.excerpt}</span>)}
                    </p>
                    <span class="featured-readmore" data-i18n="blog.readmore">Leer artículo completo →</span>
                </a>
            </div>
        </section>
    )}

    <section class="cta">
        <h2 data-i18n="index.cta.title">EXPLORA LOS DATOS</h2>
        <div class="cta-buttons">
            <a href={`${base}estadisticas/`} class="btn" data-i18n="index.cta.stats">VER ESTADÍSTICAS</a>
            <a href={`${base}asimetrias/`} class="btn" data-i18n="index.cta.asym">ASIMETRÍAS LEGALES</a>
            <a href={`${base}blog/`} class="btn" data-i18n="index.cta.blog">LEER EL BLOG</a>
        </div>
    </section>
</Layout>

<style>
    .hero {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #fff;
        padding: 8rem 2rem 4rem;
        position: relative;
    }

    .hero-content {
        max-width: 1100px;
        width: 100%;
        text-align: center;
    }

    .hero-eyebrow {
        font-size: 0.8rem;
        font-weight: 700;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        opacity: 0.55;
        margin-bottom: 1.5rem;
    }

    .hero-title {
        font-family: 'Bebas Neue', sans-serif;
        font-size: clamp(3rem, 8vw, 7rem);
        line-height: 0.9;
        margin-bottom: 2rem;
        text-transform: uppercase;
    }

    .hero-subtitle {
        font-size: clamp(1rem, 2vw, 1.3rem);
        margin-bottom: 5rem;
        max-width: 800px;
        margin-left: auto;
        margin-right: auto;
        opacity: 0.7;
    }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 3rem;
        margin-top: 6rem;
        max-width: 1000px;
        margin-left: auto;
        margin-right: auto;
    }

    .stat-card {
        background: #fff;
        border: 3px solid #000;
        padding: 3rem 2rem;
        transition: all 0.3s ease;
        text-align: center;
    }

    .stat-card:hover {
        transform: translate(-6px, -6px);
        box-shadow: 6px 6px 0 #000;
    }

    .stat-card-number {
        font-family: 'Bebas Neue', sans-serif;
        font-size: 5rem;
        line-height: 1;
        margin-bottom: 1rem;
    }

    .stat-card-label {
        font-size: 0.9rem;
        text-transform: uppercase;
        font-weight: 700;
        line-height: 1.5;
    }

    .data-section {
        background: #f9f9f9;
        padding: 6rem 2rem;
        border-top: 3px solid #000;
    }

    .container {
        max-width: 1100px;
        margin: 0 auto;
    }

    .data-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 3rem;
    }

    .data-box {
        border: 3px solid #000;
        padding: 3rem 2.5rem;
        background: #fff;
        transition: all 0.3s ease;
    }

    .data-box:hover {
        transform: translate(-6px, -6px);
        box-shadow: 6px 6px 0 #000;
    }

    .data-box h3 {
        font-family: 'Bebas Neue', sans-serif;
        font-size: 5rem;
        margin-bottom: 1rem;
        line-height: 0.9;
    }

    .data-box p {
        font-size: 0.95rem;
        line-height: 1.7;
    }

    .mission {
        background: #000;
        color: #fff;
        padding: 6rem 2rem;
        border-top: 3px solid #000;
    }

    .mission h2 {
        font-family: 'Bebas Neue', sans-serif;
        font-size: clamp(3rem, 6vw, 5rem);
        margin-bottom: 3rem;
        text-align: center;
        letter-spacing: 2px;
    }

    .mission-content {
        max-width: 850px;
        margin: 0 auto;
    }

    .mission p {
        font-size: 1.1rem;
        line-height: 2;
        margin-bottom: 2rem;
    }

    .mission .highlight {
        background: #fff;
        color: #000;
        padding: 0.3rem 0.6rem;
        font-weight: 700;
        display: inline-block;
    }

    .featured {
        background: #fff;
        padding: 6rem 2rem;
        border-top: 3px solid #000;
    }

    .featured-kicker {
        font-family: 'Bebas Neue', sans-serif;
        font-size: 1.3rem;
        letter-spacing: 2px;
        margin-bottom: 1.5rem;
    }

    .featured-card {
        display: block;
        border: 3px solid #000;
        padding: 3rem;
        text-decoration: none;
        color: #000;
        transition: all 0.3s ease;
    }

    .featured-card:hover {
        transform: translate(-6px, -6px);
        box-shadow: 6px 6px 0 #000;
    }

    .featured-title {
        font-family: 'Bebas Neue', sans-serif;
        font-size: clamp(2rem, 4vw, 3rem);
        line-height: 1.05;
        margin-bottom: 1.5rem;
        text-transform: uppercase;
    }

    .featured-excerpt {
        font-size: 1rem;
        line-height: 1.7;
        opacity: 0.75;
        margin-bottom: 2rem;
        max-width: 800px;
    }

    .featured-readmore {
        display: inline-block;
        padding: 1rem 2rem;
        background: #000;
        color: #fff;
        font-weight: 700;
        text-transform: uppercase;
        font-size: 0.85rem;
    }

    .cta {
        text-align: center;
        padding: 6rem 2rem;
        background: #fff;
        border-top: 3px solid #000;
    }

    .cta h2 {
        font-family: 'Bebas Neue', sans-serif;
        font-size: clamp(3rem, 6vw, 5rem);
        margin-bottom: 4rem;
        text-transform: uppercase;
        letter-spacing: 2px;
    }

    .cta-buttons {
        display: flex;
        gap: 2.5rem;
        justify-content: center;
        flex-wrap: wrap;
    }

    .cta .btn {
        display: inline-block;
        padding: 1.8rem 4rem;
        background: #000;
        color: #fff;
        text-decoration: none;
        font-family: 'Bebas Neue', sans-serif;
        font-size: 1.5rem;
        border: 3px solid #000;
        transition: all 0.3s ease;
        letter-spacing: 2px;
        text-transform: uppercase;
        min-width: 300px;
    }

    .cta .btn:hover {
        background: #fff;
        color: #000;
        transform: translate(-6px, -6px);
        box-shadow: 6px 6px 0 #000;
    }

    @media (max-width: 968px) {
        .hero {
            padding: 17rem 1.5rem 4rem;
            min-height: auto;
        }

        .hero-subtitle {
            margin-bottom: 3rem;
        }

        .stats-grid {
            grid-template-columns: 1fr;
            gap: 1.5rem;
            margin-top: 3rem;
        }

        .data-grid {
            grid-template-columns: 1fr;
            gap: 1.5rem;
        }

        .data-section {
            padding: 4rem 1.5rem;
        }

        .mission {
            padding: 4rem 1.5rem;
        }

        .featured {
            padding: 4rem 1.5rem;
        }

        .featured-card {
            padding: 2rem 1.5rem;
        }

        .cta {
            padding: 4rem 1.5rem;
        }

        .cta-buttons {
            flex-direction: column;
            align-items: center;
        }

        .cta .btn {
            width: 100%;
            max-width: 320px;
            min-width: unset;
            padding: 1.4rem 2rem;
        }
    }

    @media (max-width: 480px) {
        .stat-card-number {
            font-size: 4rem;
        }

        .data-box h3 {
            font-size: 3.5rem;
        }

        .data-box {
            padding: 2rem 1.5rem;
        }

        .stat-card {
            padding: 2rem 1.5rem;
        }
    }
</style>
